-- Delta Customization + smaller top bar (single script)
local SCALE = 0.7   -- 1 = normal, 0.7 = smaller, 0.5 = tiny
local DEBUG = false -- set true to print what bar got picked

loadstring(game:HttpGet("https://raw.githubusercontent.com/ltseverydayyou/uuuuuuu/refs/heads/main/DeltaCustomizationModule.luau"))()

local function getRoots()
	local roots = {}
	if gethui then
		local ok, h = pcall(gethui)
		if ok and h then table.insert(roots, h) end
	end
	table.insert(roots, game:GetService("CoreGui"))
	local lp = game:GetService("Players").LocalPlayer
	if lp and lp:FindFirstChild("PlayerGui") then
		table.insert(roots, lp.PlayerGui)
	end
	return roots
end

local function findMain()
	for _, root in getRoots() do
		for _, g in root:GetChildren() do
			if g:IsA("ScreenGui") and g:FindFirstChild("Executor", true) and g:FindFirstChild("Sidebar", true) then
				return g
			end
		end
	end
end

local function countButtons(inst)
	local n = 0
	for _, d in inst:GetDescendants() do
		if d:IsA("GuiButton") then n += 1 end
	end
	return n
end

local function findBar(main)
	local vp = main.AbsoluteSize
	local best, bestScore = nil, -math.huge
	for _, d in main:GetDescendants() do
		if d:IsA("GuiObject") and d.Visible then
			local pos, size = d.AbsolutePosition, d.AbsoluteSize
			if pos.Y < vp.Y * 0.2
				and size.X > 150
				and size.Y >= 30
				and size.Y <= vp.Y * 0.3
				and size.X > size.Y * 2
			then
				local n = countButtons(d)
				if n >= 4 then
					local score = n * 1000000 - size.X * size.Y
					if score > bestScore then
						best, bestScore = d, score
					end
				end
			end
		end
	end
	return best
end

task.spawn(function()
	local bar
	for _ = 1, 20 do
		task.wait(0.5)
		local main = findMain()
		if main then
			bar = findBar(main)
			if bar then break end
		end
	end

	if not bar then
		warn("[TopBar] could not find the top bar")
		return
	end

	local sc = bar:FindFirstChild("LT_TopBarScale")
	if not sc then
		sc = Instance.new("UIScale")
		sc.Name = "LT_TopBarScale"
		sc.Parent = bar
	end
	sc.Scale = SCALE

	if DEBUG then
		print("[TopBar] scaled:", bar:GetFullName(), "to", SCALE)
	end
end)
